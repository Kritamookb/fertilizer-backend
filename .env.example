APP_NAME=Fertilizer Backend
DEBUG=false
DATABASE_URL=postgresql+psycopg://fertilizer:change-me@localhost:5432/fertilizer
# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COMMISSION_RATE_PER_UNIT=25
MAX_AGENTS=50
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Only used to create the first admin on an empty database (min. 12 characters)
ADMIN_PASSWORD=
